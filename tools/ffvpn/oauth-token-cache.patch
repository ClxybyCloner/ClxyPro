+// oauthTokenLead is the safety margin before a cached OAuth token's expiry:
+// the token is treated as dead this long before the server says it is, the
+// way the desktop core's FreshRuntimeAuth keeps a 2-minute lead.
+const oauthTokenLead = 2 * time.Minute
+
+// cachedOAuthToken returns an OAuth access token for the session, reusing a
+// cached one while it is fresh. The authorization exchange hits
+// oauth.accounts.firefox.com, which stalls like the auth server on a
+// filtered path (seen 2026-11-21: /oauth/authorization timed out after the
+// session check itself was cached); a cached token skips both calls. The
+// cache lives next to the token file and is bound to the session token, so
+// a new sign-in re-exchanges. The second return value reports a cache hit.
+func cachedOAuthToken(oauthClient *fxa.OAuthClient, session *fxa.Session, opts *options) (string, bool, error) {
+	if opts.sessionTokenFile != "" {
+		if token, ok := readOAuthToken(opts.sessionTokenFile, session.Token); ok {
+			log.Printf("Using cached OAuth token")
+			return token, true, nil
+		}
+	}
+	token, expiresIn, err := oauthClient.TokenForSessionExpiry(session, []string{"profile", vpnScope})
+	if err != nil {
+		return "", false, err
+	}
+	if opts.sessionTokenFile != "" && expiresIn > oauthTokenLead {
+		writeOAuthToken(opts.sessionTokenFile, session.Token, token, time.Now().Add(expiresIn-oauthTokenLead))
+	}
+	return token, false, nil
+}
+
+func oauthTokenFile(tokenFile string) string { return tokenFile + ".oauth" }
+
+// readOAuthToken returns the cached token when the sidecar file holds one
+// for this exact session token that has not expired yet.
+func readOAuthToken(tokenFile, sessionToken string) (string, bool) {
+	data, err := os.ReadFile(oauthTokenFile(tokenFile))
+	if err != nil {
+		return "", false
+	}
+	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
+	if len(lines) != 3 {
+		return "", false
+	}
+	sum := sha256.Sum256([]byte(sessionToken))
+	if lines[0] != hex.EncodeToString(sum[:]) {
+		return "", false
+	}
+	expiresUnix, err := strconv.ParseInt(strings.TrimSpace(lines[2]), 10, 64)
+	if err != nil || time.Now().Unix() >= expiresUnix {
+		return "", false
+	}
+	token := strings.TrimSpace(lines[1])
+	if token == "" {
+		return "", false
+	}
+	return token, true
+}
+
+// writeOAuthToken records a fresh token with its expiry. A write failure is
+// ignored: the next connect simply exchanges again.
+func writeOAuthToken(tokenFile, sessionToken, token string, expires time.Time) {
+	sum := sha256.Sum256([]byte(sessionToken))
+	body := hex.EncodeToString(sum[:]) + "\n" + token + "\n" +
+		strconv.FormatInt(expires.Unix(), 10) + "\n"
+	// An OAuth token is a bearer credential; keep it 0600 like the session.
+	_ = os.WriteFile(oauthTokenFile(tokenFile), []byte(body), 0o600)
+}
+
+func dropOAuthToken(tokenFile string) {
+	if tokenFile != "" {
+		os.Remove(oauthTokenFile(tokenFile))
+	}
+}
